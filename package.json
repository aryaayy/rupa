{
  "name": "rupa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1 --port 5173 --strictPort",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:contracts": "forge test --root contracts --no-match-path 'test/fork/*'",
    "test:fork": "node scripts/run-fork-tests.mjs",
    "verify:monad": "node scripts/verify-monad.mjs",
    "check:format": "forge fmt --root contracts --check",
    "check:secrets": "gitleaks dir . --redact --config .gitleaks.toml",
    "check": "pnpm typecheck && pnpm test && pnpm test:contracts && pnpm check:format"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
